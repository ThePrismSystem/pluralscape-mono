{
  "config": {
    // Prose wraps however the writer left it, and rewrapping only churns history.
    "MD013": false,
    // Table pipe alignment follows Prettier.
    "MD060": false,
    // A changelog repeats Added and Fixed under each version.
    "MD024": { "siblings_only": true },
  },
  "gitignore": true,
  "ignores": [
    ".github/pull_request_template.md",
    // Written by the beans CLI.
    ".beans/**",
    // Generated by `pnpm roadmap`.
    "docs/roadmap.md",
    // Frozen records of past audits.
    "security/**",
    "docs/audits/**",
  ],
}
