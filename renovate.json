{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["on monday"],
  "labels": ["domain: infra"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev dependencies (patch/minor)"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": ["fast-xml-parser"],
      "allowedVersions": "~5.5.7",
      "description": "Pinned: 5.7.x rejects &#xD; entities in S3 XML responses, breaking @aws-sdk/xml-builder. Revisit when upstream regression is fixed."
    },
    {
      "matchPackageNames": ["react", "react-dom"],
      "allowedVersions": "19.2.3",
      "description": "Pinned to the React version Expo SDK 56 bundles, which react-native 0.85's renderer checks at runtime. Bump during an Expo SDK upgrade."
    },
    {
      "matchPackageNames": ["@types/react", "@types/react-dom"],
      "allowedVersions": "~19.2.0",
      "description": "Held to the React line Expo SDK 56 bundles."
    },
    {
      "matchPackageNames": ["react-native"],
      "allowedVersions": "0.85.3",
      "description": "Pinned to the react-native version Expo SDK 56 requires. Bump during an Expo SDK upgrade."
    },
    {
      "matchPackageNames": [
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-web"
      ],
      "enabled": false,
      "description": "Versions come from the Expo SDK. `expo install --check` in the Mobile Bundle job fails if they drift. Bump with `expo install --fix` during an SDK upgrade."
    }
  ]
}
